{
  "name": "pkm-survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalogue && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "roster": "node scripts/roster.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "credits": "node scripts/credits.mjs",
    "bodies": "node scripts/bodies.mjs",
    "multiplayer": "node server/rooms.mjs",
    "test:rooms": "node --test server/rooms.integration.mjs",
    "catalogue": "node scripts/catalogue.mjs",
    "test:firebase": "npx --yes firebase-tools@15.34.0 emulators:exec --project demo-pkm-survivors --only auth,database,firestore \"node --test scripts/firebase.integration.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "firebase": "^13.0.0",
    "ws": "^8.22.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emegeaese/pkm-survivors.git"
  },
  "bugs": {
    "url": "https://github.com/Emegeaese/pkm-survivors/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}

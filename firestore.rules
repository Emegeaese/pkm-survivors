rules_version = '2';

// Reglas de seguridad de PokéSurvivor.
//   saves/{uid}            partida: sólo su dueño
//   names/{apodo}          reserva de apodos únicos (en minúsculas)
//   profiles/{uid}         apodo público de cada jugador
//   friendships/{a_b}      solicitudes y amistades entre dos jugadores
//   trades/{a_b}           intercambio de Pokémon entre dos amigos
//   runs/{uid}             cuándo empezó tu última partida (anti-trampas)
//   lb/{tabla}/e/{id}      ranking de tiempo aguantado (marcas validadas)
//   lbs/{tabla}            resumen con el top 50 de cada tabla
//   pres/{uid}             en línea (aproximado) · inv/{para_de} invitaciones
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    match /saves/{uid} {
      allow read, delete: if signedIn() && me() == uid;

      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v'])
        && request.resource.data.save is map
        && request.resource.data.v is int
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- apodos ----------

    match /names/{lower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && lower.size() >= 3 && lower.size() <= 16
        && lower == lower.lower();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Perfil público: apodo, 3 favoritos, título, mejores marcas y medallas.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'lower', 'at', 'favs', 'title', 'best', 'medals'])
        && request.resource.data.name is string
        && request.resource.data.lower == request.resource.data.name.lower()
        && request.resource.data.at == request.time
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 3))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 40))
        && (!('best' in request.resource.data) || request.resource.data.best is map)
        && (!('medals' in request.resource.data) || (request.resource.data.medals is list && request.resource.data.medals.size() <= 8))
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.lower)).data.uid == me();
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- amigos ----------
    // Un documento por pareja, con id "uidMenor_uidMayor".

    match /friendships/{pid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'names', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && me() in request.resource.data.users
        && request.resource.data.to in request.resource.data.users
        && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      // Sólo quien la recibe puede aceptarla.
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at', 'names'])
        && request.resource.data.status == 'ok';
      allow delete: if signedIn() && me() in resource.data.users;
    }

    // ---------- intercambios ----------
    // Un documento por pareja de amigos (mismo id que la amistad). Cada uno
    // sólo escribe SU parte (o/ok/done); las dos mitades del cambio las aplica
    // cada cliente en su propia partida. Mientras alguien haya terminado de
    // aplicarlo, nadie puede retirar ofertas ni aceptaciones.
    match /trades/{pid} {
      function tShape(d) {
        return d.keys().hasOnly(['users', 'names', 'c', 'o', 'ok', 'done', 'at'])
          && d.users is list && d.users.size() == 2
          && d.names is map && d.o is map && d.ok is map && d.done is map
          && d.c is int
          && d.at == request.time;
      }
      function tOffer(o) {
        return !(me() in o)
          || (o[me()].keys().hasOnly(['dex', 'sh']) && o[me()].dex is int && o[me()].sh is bool);
      }

      allow read: if signedIn() && (resource == null || me() in resource.data.users);

      allow create: if signedIn()
        && tShape(request.resource.data)
        && request.resource.data.users[0] < request.resource.data.users[1]
        && me() in request.resource.data.users
        && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.o.keys().hasOnly([me()])
        && tOffer(request.resource.data.o)
        && request.resource.data.ok.size() == 0
        && request.resource.data.done.size() == 0
        && get(/databases/$(database)/documents/friendships/$(pid)).data.status == 'ok';

      allow update: if signedIn()
        && me() in resource.data.users
        && tShape(request.resource.data)
        && request.resource.data.users == resource.data.users
        && request.resource.data.names == resource.data.names
        && request.resource.data.c == resource.data.c
        && request.resource.data.o.diff(resource.data.o).affectedKeys().hasOnly([me()])
        && request.resource.data.ok.diff(resource.data.ok).affectedKeys().hasOnly([me()])
        && request.resource.data.done.diff(resource.data.done).affectedKeys().hasOnly([me()])
        && tOffer(request.resource.data.o)
        && (resource.data.done.size() == 0
            || (request.resource.data.o == resource.data.o && request.resource.data.ok == resource.data.ok));

      allow delete: if signedIn()
        && me() in resource.data.users
        && (resource.data.ok.size() < 2 || resource.data.done.size() == 2);
    }

    // ---------- ranking ----------

    match /runs/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['startedAt', 'mode'])
        && request.resource.data.startedAt == request.time;
    }

    // Una entrada no puede durar más que el tiempo real desde que empezó tu
    // partida (runs/{uid}), y sólo se puede mejorar, nunca empeorar.
    // Anti-trampas: el nivel y los derrotados tienen que cuadrar con el tiempo
    // (con margen de sobra para un jugador muy bueno o un grupo de 4).
    function validEntry(board, id) {
      let d = request.resource.data;
      let run = get(/databases/$(database)/documents/runs/$(me())).data;
      return d.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills', 'at'])
        && d.t is int && d.t > 0 && d.t <= 21600
        && d.t <= (request.time - run.startedAt).seconds() + 15
        && d.lv is int && d.lv >= 1 && d.lv <= 10 + d.t / 4
        && d.kills is int && d.kills >= 0 && d.kills <= 100 + d.t * 12
        && d.uids is list && me() in d.uids
        && d.names is list && d.names.size() == d.uids.size()
        && d.dex is list && d.dex.size() == d.uids.size()
        && d.shiny is list && d.shiny.size() == d.uids.size()
        && d.at == request.time
        && (board.matches('s_.*')
              ? (d.uids.size() == 1 && id == me())
              : (d.uids.size() >= 2 && d.uids.size() <= 4 && id == d.uids.join('_')))
        && (resource == null || d.t > resource.data.t);
    }

    match /lb/{board}/e/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validEntry(board, id);
      allow delete: if signedIn() && me() in resource.data.uids;
    }

    // Resumen con el top 50 de cada tabla (lo que se lee al mirar el ranking).
    //   top: { id: { t, uids, names, dex, shiny, lv, kills } }
    //   me:  la fila que añades o mejoras (debe coincidir con tu marca validada,
    //        escrita en la misma transacción)
    //   ev:  la fila que sale del top (sólo si tiene menos tiempo que la tuya)
    // Al borrar la cuenta: me = '' y ev = una fila tuya que se quita.
    function validTop(board) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data.top;
      let changed = d.top.diff(old).affectedKeys();
      return d.keys().hasOnly(['top', 'me', 'ev'])
        && d.top is map && d.top.size() <= 50
        && d.me is string && d.ev is string
        && (d.me == '' ? removeMine(d, old, changed) : addMine(board, d, old, changed));
    }
    function addMine(board, d, old, changed) {
      let e = getAfter(/databases/$(database)/documents/lb/$(board)/e/$(d.me)).data;
      let row = d.top[d.me];
      return me() in e.uids
        && changed.hasOnly([d.me, d.ev])
        && row.t == e.t && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && (d.ev == '' || (!(d.ev in d.top) && d.ev in old && old[d.ev].t <= e.t));
    }
    function removeMine(d, old, changed) {
      return d.ev in old && me() in old[d.ev].uids && !(d.ev in d.top) && changed.hasOnly([d.ev]);
    }

    match /lbs/{board} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTop(board);
    }

    // Presencia aproximada: "en línea" si at es de hace menos de unos minutos.
    match /pres/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['at', 'room', 'play', 'on'])
        && request.resource.data.at == request.time
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.play is bool && request.resource.data.on is bool;
      allow delete: if signedIn() && me() == uid;
    }

    // Invitaciones a una sala: id "para_de". Sólo entre amigos confirmados.
    match /inv/{id} {
      allow read: if signedIn() && (resource == null || me() == resource.data.to || me() == resource.data.from);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'from', 'room', 'name', 'at'])
        && request.resource.data.from == me()
        && id == request.resource.data.to + '_' + me()
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.to < me() ? request.resource.data.to + '_' + me() : me() + '_' + request.resource.data.to)).data.status == 'ok';
      allow delete: if signedIn() && (me() == resource.data.to || me() == resource.data.from);
    }

    // Para borrar todas tus marcas al borrar la cuenta (consulta de grupo).
    match /{path=**}/e/{id} {
      allow read: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
    // PKM Survivors v2: separate collections; original game data is untouched.
    function pkmOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function pkmRun(d) {
      return request.auth != null && d.uid == request.auth.uid
        && d.team is list && d.team.size() >= 1 && d.team.size() <= 4 && request.auth.uid in d.team
        && d.names is list && d.names.size() == d.team.size()
        && d.name is string && d.name.size() <= 110 && d.handle is string && d.handle.size() <= 24
        && d.starter is string && d.starter.size() <= 40 && d.stage is int && d.stage >= 0 && d.stage <= 2
        && d.difficulty in ['normal', 'hard', 'nightmare'] && d.outcome in ['victory', 'death', 'quit']
        && d.time is number && d.time >= 0 && d.time <= 14400
        && d.level is int && d.level >= 1 && d.level <= 999
        && d.kills is int && d.kills >= 0 && d.kills <= d.time * 40 + 1
        && d.version is string && d.version.size() <= 40 && d.at is string && d.at.size() <= 40
        && d.verified == false && d.runId is string;
    }
    function pkmStarted(d) {
      let start = get(/databases/$(database)/documents/pkmStarts/$(d.runId)).data;
      return start.uid == request.auth.uid && start.team == d.team
        && start.startedAt + duration.value(int(d.time) - 30, 's') <= request.time
        && (start.mode == 'versus' || d.outcome != 'victory' || d.time >= 900);
    }
    function pkmBoard(board, entry, d) {
      let start = get(/databases/$(database)/documents/pkmStarts/$(d.runId)).data;
      return ((board.matches('^' + start.mode + '_' + d.difficulty + '_' + (start.mode == 'coop' ? string(start.teamSize) : '1') + '_(day|week|all)_[0-9a-z-]+$')
          && entry == (start.mode == 'coop' ? start.teamId : d.uid)
          && (start.mode == 'versus'
            ? d.score == d.wins && d.wins is int && d.wins == (resource == null ? 0 : resource.data.wins) +
              (!exists(/databases/$(database)/documents/pkmRuns/$(d.runId)) && d.outcome == 'victory' ? 1 : 0)
            : d.score == d.time && d.wins == 0))
        || (start.mode == 'solo' && start.challenge is string && board == 'challenge_' + start.challenge
          && entry == d.uid && d.score == d.time && d.wins == 0 && (resource == null || resource.data.runId == d.runId)))
        && (resource == null || (resource.data.team == d.team && d.score >= resource.data.score));
    }
    match /pkmSaves/{uid} {
      allow read: if pkmOwner(uid);
      allow create, update: if pkmOwner(uid)
        && request.resource.data.keys().hasOnly(['save', 'revision', 'updatedAt'])
        && request.resource.data.save is map && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && request.resource.data.updatedAt == request.time;
    }
    match /pkmProfiles/{uid} {
      allow read: if true;
      allow create, update: if pkmOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'handle', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/pkmHandles/$(request.resource.data.handle)).data.uid == uid;
    }
    match /pkmHandles/{handle} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid && handle.matches('^[a-z0-9_]{3,20}$');
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data == resource.data;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /pkmStats/{uid} {
      allow read: if true;
      allow create, update: if pkmOwner(uid) && request.resource.data.keys().hasOnly(['seen', 'caught'])
        && request.resource.data.seen is int && request.resource.data.caught is int
        && request.resource.data.seen >= 0 && request.resource.data.seen <= 2000
        && request.resource.data.caught >= 0 && request.resource.data.caught <= 2000;
    }
    match /pkmStarts/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'uid', 'mode', 'team', 'names', 'teamSize', 'teamId', 'challenge', 'startedAt'])
        && request.resource.data.id == id && request.resource.data.mode in ['solo', 'coop', 'versus']
        && request.resource.data.team is list && request.resource.data.team.size() >= 1 && request.resource.data.team.size() <= 4
        && request.resource.data.teamSize == request.resource.data.team.size()
        && request.resource.data.teamId is string && request.resource.data.teamId.size() <= 520
        && ((request.resource.data.mode == 'solo' && request.resource.data.teamSize == 1) || (request.resource.data.mode != 'solo' && request.resource.data.teamSize >= 2))
        && request.auth.uid in request.resource.data.team
        && request.resource.data.names is list && request.resource.data.names.size() == request.resource.data.team.size()
        && request.resource.data.startedAt == request.time;
    }
    match /pkmRuns/{id} {
      allow read: if true;
      allow create, update: if pkmRun(request.resource.data) && pkmStarted(request.resource.data)
        && request.resource.data.runId == id && request.resource.data.startId == id
        && request.resource.data.mode == get(/databases/$(database)/documents/pkmStarts/$(id)).data.mode
        && request.resource.data.updatedAt == request.time
        && (resource == null || (resource.data.uid == request.auth.uid && request.resource.data.time > resource.data.time));
    }
    match /pkmBoards/{board}/entries/{entry} {
      allow read: if true;
      allow create, update: if pkmRun(request.resource.data) && pkmStarted(request.resource.data)
        && getAfter(/databases/$(database)/documents/pkmRuns/$(request.resource.data.runId)).data.time == request.resource.data.time
        && getAfter(/databases/$(database)/documents/pkmRuns/$(request.resource.data.runId)).data.uid == request.auth.uid
        && pkmBoard(board, entry, request.resource.data);
    }
    match /pkmFollows/{uid}/targets/{handle} {
      allow read: if true;
      allow delete: if pkmOwner(uid);
      allow create, update: if pkmOwner(uid) && request.resource.data.keys().hasOnly(['handle']) && request.resource.data.handle == handle;
    }
    match /pkmFans/{handle}/uids/{uid} {
      allow read: if true;
      allow delete: if pkmOwner(uid);
      allow create, update: if pkmOwner(uid) && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid
        && getAfter(/databases/$(database)/documents/pkmFollows/$(uid)/targets/$(handle)).data.handle == handle;
    }

  }
}

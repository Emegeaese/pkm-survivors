# Public Firebase web config defaults to Emegeaese's existing pokesurvivors project.
# Access is enforced by Firebase security rules. No admin credentials belong here.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_DATABASE_URL=
VITE_SITE_URL=https://pkm-survivors-emegeaese.web.app

# Local tests only. Never enable in a production build.
# VITE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_PROJECT_ID=demo-pkm-survivors
# VITE_FIREBASE_DATABASE_URL=https://demo-pkm-survivors-default-rtdb.firebaseio.com
# VITE_FIREBASE_FORCE_RELAY=true

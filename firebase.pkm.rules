    // PKM Survivors v2: separate collections; original game data is untouched.
    function pkmOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function pkmRun(d) {
      return request.auth != null && d.uid == request.auth.uid
        && d.team is list && d.team.size() >= 1 && d.team.size() <= 4 && request.auth.uid in d.team
        && d.names is list && d.names.size() == d.team.size()
        && d.name is string && d.name.size() <= 110 && d.handle is string && d.handle.size() <= 24
        && d.starter is string && d.starter.size() <= 40 && d.stage is int && d.stage >= 0 && d.stage <= 2
        && d.difficulty in ['normal', 'hard', 'nightmare'] && d.outcome in ['victory', 'death', 'quit']
        && d.time is number && d.time >= 0 && d.time <= 14400
        && d.level is int && d.level >= 1 && d.level <= 999
        && d.kills is int && d.kills >= 0 && d.kills <= d.time * 40 + 1
        && d.version is string && d.version.size() <= 40 && d.at is string && d.at.size() <= 40
        && d.verified == false && d.runId is string;
    }
    function pkmStarted(d) {
      let start = get(/databases/$(database)/documents/pkmStarts/$(d.runId)).data;
      return start.uid == request.auth.uid && start.team == d.team
        && start.startedAt + duration.value(int(d.time) - 30, 's') <= request.time
        && (start.mode == 'versus' || d.outcome != 'victory' || d.time >= 900);
    }
    function pkmBoard(board, entry, d) {
      let start = get(/databases/$(database)/documents/pkmStarts/$(d.runId)).data;
      return ((board.matches('^' + start.mode + '_' + d.difficulty + '_' + (start.mode == 'coop' ? string(start.teamSize) : '1') + '_(day|week|all)_[0-9a-z-]+$')
          && entry == (start.mode == 'coop' ? start.teamId : d.uid)
          && (start.mode == 'versus'
            ? d.score == d.wins && d.wins is int && d.wins == (resource == null ? 0 : resource.data.wins) +
              (!exists(/databases/$(database)/documents/pkmRuns/$(d.runId)) && d.outcome == 'victory' ? 1 : 0)
            : d.score == d.time && d.wins == 0))
        || (start.mode == 'solo' && start.challenge is string && board == 'challenge_' + start.challenge
          && entry == d.uid && d.score == d.time && d.wins == 0 && (resource == null || resource.data.runId == d.runId)))
        && (resource == null || (resource.data.team == d.team && d.score >= resource.data.score));
    }
    match /pkmSaves/{uid} {
      allow read: if pkmOwner(uid);
      allow create, update: if pkmOwner(uid)
        && request.resource.data.keys().hasOnly(['save', 'revision', 'updatedAt'])
        && request.resource.data.save is map && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && request.resource.data.updatedAt == request.time;
    }
    match /pkmProfiles/{uid} {
      allow read: if true;
      allow create, update: if pkmOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'handle', 'updatedAt', 'friends', 'photo', 'wall', 'favs', 'title'])
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 24))
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 40))
        && (!('wall' in request.resource.data) || (request.resource.data.wall is string && request.resource.data.wall.size() <= 20))
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 3))
        && (!('friends' in request.resource.data) || (request.resource.data.friends is list && request.resource.data.friends.size() <= 100))
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/pkmHandles/$(request.resource.data.handle)).data.uid == uid;
    }
    match /pkmHandles/{handle} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid && handle.matches('^[a-z0-9_]{3,20}$');
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data == resource.data;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /pkmStats/{uid} {
      allow read: if true;
      allow create, update: if pkmOwner(uid) && request.resource.data.keys().hasOnly(['seen', 'caught', 'coopRuns', 'coopWins', 'coopMinutes', 'coopRevivals', 'versusRuns', 'versusWins'])
        && request.resource.data.values().size() <= 8
        && request.resource.data.get('seen', 0) is int && request.resource.data.get('seen', 0) >= 0 && request.resource.data.get('seen', 0) <= 2000
        && request.resource.data.get('caught', 0) is int && request.resource.data.get('caught', 0) >= 0 && request.resource.data.get('caught', 0) <= 2000
        && request.resource.data.get('coopRuns', 0) is int && request.resource.data.get('coopRuns', 0) >= 0
        && request.resource.data.get('coopWins', 0) is int && request.resource.data.get('coopWins', 0) >= 0
        && request.resource.data.get('coopMinutes', 0) is int && request.resource.data.get('coopMinutes', 0) >= 0
        && request.resource.data.get('coopRevivals', 0) is int && request.resource.data.get('coopRevivals', 0) >= 0
        && request.resource.data.get('versusRuns', 0) is int && request.resource.data.get('versusRuns', 0) >= 0
        && request.resource.data.get('versusWins', 0) is int && request.resource.data.get('versusWins', 0) >= 0;
    }
    match /pkmStarts/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'uid', 'mode', 'team', 'names', 'teamSize', 'teamId', 'challenge', 'startedAt'])
        && request.resource.data.id == id && request.resource.data.mode in ['solo', 'coop', 'versus']
        && request.resource.data.team is list && request.resource.data.team.size() >= 1 && request.resource.data.team.size() <= 4
        && request.resource.data.teamSize == request.resource.data.team.size()
        && request.resource.data.teamId is string && request.resource.data.teamId.size() <= 520
        && ((request.resource.data.mode == 'solo' && request.resource.data.teamSize == 1) || (request.resource.data.mode != 'solo' && request.resource.data.teamSize >= 2))
        && request.auth.uid in request.resource.data.team
        && request.resource.data.names is list && request.resource.data.names.size() == request.resource.data.team.size()
        && request.resource.data.startedAt == request.time;
    }
    match /pkmRuns/{id} {
      allow read: if true;
      allow create, update: if pkmRun(request.resource.data) && pkmStarted(request.resource.data)
        && request.resource.data.runId == id && request.resource.data.startId == id
        && request.resource.data.mode == get(/databases/$(database)/documents/pkmStarts/$(id)).data.mode
        && request.resource.data.updatedAt == request.time
        && (resource == null || (resource.data.uid == request.auth.uid && request.resource.data.time > resource.data.time));
    }
    match /pkmBoards/{board}/entries/{entry} {
      allow read: if true;
      // A teammate may add the missing line-up to a co-op record, and nothing else.
      allow update: if request.auth != null && board.matches('^coop_.*') && resource.data.team is list && request.auth.uid in resource.data.team
        && !('lineup' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineup'])
        && request.resource.data.lineup is list && request.resource.data.lineup.size() >= 1 && request.resource.data.lineup.size() <= 4;
      allow create, update: if pkmRun(request.resource.data) && pkmStarted(request.resource.data)
        && getAfter(/databases/$(database)/documents/pkmRuns/$(request.resource.data.runId)).data.time == request.resource.data.time
        && getAfter(/databases/$(database)/documents/pkmRuns/$(request.resource.data.runId)).data.uid == request.auth.uid
        && pkmBoard(board, entry, request.resource.data);
    }
    function pkmPair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function pkmFriends(a, b) {
      return exists(/databases/$(database)/documents/pkmFriendships/$(pkmPair(a, b)))
        && get(/databases/$(database)/documents/pkmFriendships/$(pkmPair(a, b))).data.status == 'accepted';
    }
    match /pkmFriendships/{id} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.users);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'updatedAt'])
        && request.resource.data.from == request.auth.uid && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.users == (request.resource.data.from < request.resource.data.to
          ? [request.resource.data.from, request.resource.data.to] : [request.resource.data.to, request.resource.data.from])
        && id == pkmPair(request.resource.data.from, request.resource.data.to)
        && request.resource.data.status == 'pending' && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/pkmProfiles/$(request.resource.data.to));
      allow update: if request.auth != null && resource.data.to == request.auth.uid
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }
    function pkmOffer(o) {
      return o == null || (o is map && o.keys().hasOnly(['id', 'shiny', 'key'])
        && o.id is string && o.id.matches('^[a-z0-9-]{1,40}$') && o.shiny is bool
        && o.key == o.id + (o.shiny ? '_s' : '_n'));
    }
    function pkmStock(uid, key) {
      return exists(/databases/$(database)/documents/pkmTradeStock/$(uid)/copies/$(key))
        ? get(/databases/$(database)/documents/pkmTradeStock/$(uid)/copies/$(key)).data
        : {'earned': 0, 'sent': 0, 'received': 0};
    }
    function pkmAfterStock(uid, key) {
      return getAfter(/databases/$(database)/documents/pkmTradeStock/$(uid)/copies/$(key)).data;
    }
    function pkmStockMoved(uid, outKey, inKey, key, tradeId) {
      let old = pkmStock(uid, key);
      let next = pkmAfterStock(uid, key);
      return next.earned == old.earned
        && next.sent == old.sent + (key == outKey ? 1 : 0)
        && next.received == old.received + (key == inKey ? 1 : 0)
        && next.lastTrade == tradeId
        && (key != outKey || old.earned + old.received - old.sent >= 1);
    }
    function pkmAllMoved(d, tradeId) {
      return pkmStockMoved(d.users[0], d.left.key, d.right.key, d.left.key, tradeId)
        && pkmStockMoved(d.users[0], d.left.key, d.right.key, d.right.key, tradeId)
        && pkmStockMoved(d.users[1], d.right.key, d.left.key, d.right.key, tradeId)
        && pkmStockMoved(d.users[1], d.right.key, d.left.key, d.left.key, tradeId);
    }
    match /pkmTrades/{id} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.users);
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['users', 'left', 'right', 'leftAccepted', 'rightAccepted', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.users is list && request.resource.data.users.size() == 2
        && request.resource.data.users[0] == request.auth.uid && request.resource.data.users[1] != request.auth.uid
        && pkmFriends(request.auth.uid, request.resource.data.users[1])
        && pkmOffer(request.resource.data.left) && request.resource.data.left != null && request.resource.data.right == null
        && request.resource.data.leftAccepted == false && request.resource.data.rightAccepted == false
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && request.auth.uid in resource.data.users && resource.data.status == 'open'
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || (pkmFriends(resource.data.users[0], resource.data.users[1]) && (
          (request.resource.data.status == 'open' && pkmOffer(request.resource.data.left) && pkmOffer(request.resource.data.right)
            && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid == resource.data.users[0] ? 'left' : 'right', 'leftAccepted', 'rightAccepted', 'updatedAt'])
              && request.resource.data.leftAccepted == false && request.resource.data.rightAccepted == false)
            || (request.resource.data.left != null && request.resource.data.right != null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid == resource.data.users[0] ? 'leftAccepted' : 'rightAccepted', 'updatedAt'])
              && (request.auth.uid == resource.data.users[0] ? request.resource.data.leftAccepted : request.resource.data.rightAccepted) == true)))
          || (request.resource.data.status == 'done' && resource.data.leftAccepted && resource.data.rightAccepted
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) && pkmAllMoved(resource.data, id))
        )));
    }
    function pkmMinted(uid, d) {
      let g = get(/databases/$(database)/documents/pkmSaves/$(uid)).data.save.gacha;
      let shiny = g.get('shinyOwned', {}).get(d.id, g.get('shiny', {}).get(d.id, false) == true ? 1 : 0);
      return d.shiny ? shiny : g.get('owned', {}).get(d.id, 0) - shiny;
    }
    function pkmTransferStock(uid, key, d) {
      let before = get(/databases/$(database)/documents/pkmTrades/$(d.lastTrade)).data;
      let after = getAfter(/databases/$(database)/documents/pkmTrades/$(d.lastTrade)).data;
      let outKey = uid == before.users[0] ? before.left.key : before.right.key;
      let inKey = uid == before.users[0] ? before.right.key : before.left.key;
      return request.auth.uid in before.users && uid in before.users && before.status == 'open' && after.status == 'done'
        && before.leftAccepted && before.rightAccepted && (key == outKey || key == inKey)
        && pkmStockMoved(uid, outKey, inKey, key, d.lastTrade);
    }
    match /pkmTradeStock/{uid}/copies/{key} {
      allow read: if request.auth != null && (pkmOwner(uid) || pkmFriends(uid, request.auth.uid));
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['id', 'shiny', 'earned', 'sent', 'received', 'lastTrade'])
        && pkmOffer({'id': request.resource.data.id, 'shiny': request.resource.data.shiny, 'key': key})
        && request.resource.data.earned is int && request.resource.data.earned >= 0
        && request.resource.data.sent is int && request.resource.data.sent >= 0
        && request.resource.data.received is int && request.resource.data.received >= 0
        && request.resource.data.earned + request.resource.data.received >= request.resource.data.sent
        && ((pkmOwner(uid) && request.resource.data.earned >= (resource == null ? 0 : resource.data.earned)
          && (request.resource.data.earned == (resource == null ? 0 : resource.data.earned) || request.resource.data.earned == pkmMinted(uid, request.resource.data))
          && request.resource.data.sent == (resource == null ? 0 : resource.data.sent)
          && request.resource.data.received == (resource == null ? 0 : resource.data.received)
          && request.resource.data.lastTrade == (resource == null ? '' : resource.data.lastTrade))
        || (request.resource.data.lastTrade is string && request.resource.data.lastTrade.size() > 0 && pkmTransferStock(uid, key, request.resource.data)));
    }

    match /pkmFollows/{uid}/targets/{handle} {
      allow read: if true;
      allow delete: if pkmOwner(uid);
      allow create, update: if pkmOwner(uid) && request.resource.data.keys().hasOnly(['handle']) && request.resource.data.handle == handle;
    }
    match /pkmFans/{handle}/uids/{uid} {
      allow read: if true;
      allow delete: if pkmOwner(uid);
      allow create, update: if pkmOwner(uid) && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid
        && getAfter(/databases/$(database)/documents/pkmFollows/$(uid)/targets/$(handle)).data.handle == handle;
    }

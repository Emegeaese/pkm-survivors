# Accounts (optional). Without both, the game is guest only and the account button doesn't show.
# Clerk Dashboard → API keys → Publishable key.
VITE_CLERK_PUBLISHABLE_KEY=
# The accounts API (server/), e.g. http://localhost:3000 in dev.
VITE_API_URL=
# Optional private-room relay. Leave unset when serving game and rooms from the same host.
# VITE_ROOM_URL=wss://your-room-server.example/rooms
# Canonical site URL for generated pages and metadata (set before building).
# VITE_SITE_URL=https://your-game.example
